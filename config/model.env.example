# Model configuration used for the highscore pipeline.

MODEL_MAIN=gpt-5.4
MODEL_CHEAP=gpt-5.4-mini
MODEL_SECONDARY=gpt-5.5-openai-compact

# OpenAI-compatible API relay used by the online extraction/audit scripts.
API_KEY=replace_with_api_key
BASE_URL=https://zjapi.com

# Some historical scripts use these variable names for the audit model.
# Set them to the same main model when rerunning the online pipeline.
OPUS_MODEL=gpt-5.4
OPUS_API_KEY=replace_with_api_key

TIMEOUT=300
MAX_RETRIES=5
TEMPERATURE=0.0
